# ============================================================================
# MazelProtocol Customer Bot — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Solana Connection (required)
# ---------------------------------------------------------------------------
# Devnet:    https://api.devnet.solana.com
# Mainnet:   https://api.mainnet-beta.solana.com
RPC_URL=https://api.devnet.solana.com

# Commitment level: processed | confirmed | finalized
COMMITMENT=confirmed

# ---------------------------------------------------------------------------
# Telegram Bot (required)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather on Telegram: https://t.me/BotFather
# Use /newbot to create a bot, then copy the token here.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ---------------------------------------------------------------------------
# Program IDs (required)
# ---------------------------------------------------------------------------
MAIN_PROGRAM_ID=7WyaHk2u8AgonsryMpnvbtp42CfLJFPQpyY5p9ys6FiF
QP_PROGRAM_ID=7XC1KT5mvsHHXbR2mH6er138fu2tJ4L2fAgmpjLnnZK2

# ---------------------------------------------------------------------------
# USDC Mint (optional — for display only)
# ---------------------------------------------------------------------------
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT=

# ---------------------------------------------------------------------------
# Web App URL (for /wallet command)
# ---------------------------------------------------------------------------
WEB_APP_URL=https://app.mazelprotocol.io

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
# Port to listen on
PORT=3000

# Bot mode: "webhook" or "polling"
#   webhook — Needs a public URL. Set WEBHOOK_URL below.
#   polling — No public URL needed. Bot polls Telegram for updates.
BOT_MODE=webhook

# Public URL for webhook mode (required if BOT_MODE=webhook)
# For local dev with ngrok: https://abc123.ngrok.io
WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Authority Keypair (optional — enables custodial ticket buying)
# ---------------------------------------------------------------------------
# JSON array of the authority keypair bytes, e.g. "[1,2,3,...,255]"
# Without this, /buy and /deposit show instructions but don't execute.
# Get this from your Solana CLI keypair: cat ~/.config/solana/id.json
# AUTHORITY_KEYPAIR_JSON=[1,2,3,...,255]
