# ---------------------------------------------------------------------------
# JEBU — offchain provably-fair lottery. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Storage: local libSQL file by default; or a remote Turso URL:
#   JEBU_DATABASE_URL=libsql://your-db.turso.io
#   JEBU_DATABASE_AUTH_TOKEN=eyJ...
JEBU_DATABASE_URL=file:jebu.db
JEBU_DATABASE_AUTH_TOKEN=

# HTTP API
JEBU_PORT=3000
JEBU_HOST=127.0.0.1
# REQUIRED: strong secret protecting /admin routes. The server refuses to
# start without it. For local development only you may set the token to
# `change-me-admin-token` AND set JEBU_ALLOW_INSECURE_ADMIN=1.
JEBU_ADMIN_TOKEN=

# --- Crypto payments (Solana) ---
# Treasury wallet that receives SOL/USDC. Required for crypto orders.
JEBU_TREASURY_PUBKEY=
# Optional keypair (base58) for future operator payout tooling.
JEBU_TREASURY_KEYPAIR=
JEBU_RPC_URL=https://api.devnet.solana.com
# USDC mint: mainnet EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#            devnet 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDNCiu
JEBU_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDNCiu
# SOL → USD price used to credit SOL payments (USD per 1 SOL)
JEBU_SOL_USD_PRICE=150

# --- Engine timing ---
JEBU_TICK_MS=5000          # scheduler poll interval
JEBU_WATCH_MS=10000        # payment watcher poll interval
JEBU_COMMIT_REVEAL_DELAY_S=60
JEBU_FINALIZATION_DELAY_S=120
JEBU_ORDER_EXPIRY_S=1800   # crypto deposit orders expire after 30 min
JEBU_MIN_PAYMENT_USDC=250000   # ignore payments below 0.25 USDC
JEBU_ORDER_TOLERANCE_USDC=100000  # 0.10 USDC matching tolerance
