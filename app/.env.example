# ------------------------------------------------------------------
# MazelProtocol frontend environment
# Copy to `.env` and fill in real values. VITE_* vars are exposed to
# the browser — never put secrets here.
# ------------------------------------------------------------------

# Reown (WalletConnect) project ID — REQUIRED for wallet connection.
# Get one at https://dashboard.reown.com
# The app still renders without it, but wallet features are disabled.
VITE_REOWN_PROJECT_ID=

# Solana RPC endpoint (defaults to mainnet-beta)
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: WebSocket URL for real-time subscriptions
# VITE_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Program IDs and USDC mint (mainnet defaults — only change for custom deploys)
VITE_MAIN_LOTTERY_PROGRAM_ID=7WyaHk2u8AgonsryMpnvbtp42CfLJFPQpyY5p9ys6FiF
VITE_QUICKPICK_PROGRAM_ID=7XC1KT5mvsHHXbR2mH6er138fu2tJ4L2fAgmpjLnnZK2
VITE_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Optional: enable region gating (Cloudflare cf_country cookie)
# VITE_ENABLE_GEOBLOCK=true
